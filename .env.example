# Vercel / Supabase runtime. Set these in Vercel and locally in .env.local.
NEXT_PUBLIC_SUPABASE_URL=https://zxprjbwmfixswstqwwko.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Supabase Settings > API Keys > Secret keys. Server only; never NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=
APP_URL=https://voidstack-rosy.vercel.app
ENABLE_DEV_CHECKOUT=false
# Optional Stripe TEST configuration (unrelated to signup).
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_CONNECTED_ACCOUNTS={}

# Private product files, in MiB. Default 50 fits Supabase Free.
# 100 MB+ requires a compatible paid Storage plan and matching bucket/global limits.
# Set 5120 for a 5 GiB application ceiling only after configuring the provider.
PRODUCT_MAX_UPLOAD_MB=50
