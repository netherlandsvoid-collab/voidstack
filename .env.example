# Node 24+; single-instance local SQLite data. Never put secrets in NEXT_PUBLIC_*.
DATA_DIR=.data
APP_URL=http://localhost:3000
# Production simulation is disabled by default. Enable only on a private demo.
ENABLE_DEV_CHECKOUT=false
# Optional Stripe TEST keys. Obtain from Stripe dashboard, never commit values.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Map Nexirel seller IDs to fully onboarded test Connect accounts, server-side only.
STRIPE_CONNECTED_ACCOUNTS={}
# Supabase is an optional migration target; not used by the current SQLite runtime.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
